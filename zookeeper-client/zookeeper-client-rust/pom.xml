  <!--
  The Rust client and the Rust core of the C client libraries.

  The rust profile of zookeeper-client adds this module. Cargo does the
  work, through maven/rust-module.sh. With rust-client=no, no execution
  runs. With rust-client=yes, the module builds the zk-ffi staticlib
  that zookeeper-client-c links, and the workspace crates. maven/README.md
  gives the properties and the profiles.
  -->
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.zookeeper</groupId>
    <artifactId>zookeeper-client</artifactId>
    <version>3.10.0-SNAPSHOT</version>
  </parent>

  <artifactId>zookeeper-client-rust</artifactId>
  <packaging>pom</packaging>
  <name>Apache ZooKeeper - Client - Rust</name>
  <description>ZooKeeper Rust client and the Rust core of the C client</description>

  <properties>
    <!-- rust-client=yes sets this property to false (see the profile rust-client-yes) -->
    <rust-skip>true</rust-skip>
    <!-- plain, coverage (rust-test-coverage) or asan (rust-test-asan) -->
    <rust-test-mode>plain</rust-test-mode>
    <!-- the first port of the real-server tests; when it is empty, the real-server tests do not run -->
    <rust-test-port-base></rust-test-port-base>
    <!-- the Curator interop job (profile rust-integration) -->
    <rust-it-port-base>23400</rust-it-port-base>
    <rust-it-server-versions>head</rust-it-server-versions>
    <rust-it-mvn-args></rust-it-mvn-args>
    <skipTests>false</skipTests>
  </properties>

  <!-- these modules give the generated jute records and the test server, and set the reactor order -->
  <dependencies>
    <dependency>
      <groupId>org.apache.zookeeper</groupId>
      <artifactId>zookeeper-jute</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.zookeeper</groupId>
      <artifactId>zookeeper</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>rust-client-value</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>rust-client</property>
                  <regex>no|yes</regex>
                  <regexMessage>-Drust-client=${rust-client} is not valid: give no or yes (Maven does not support auto)</regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>${rust-skip}</skip>
          <workingDirectory>${project.basedir}</workingDirectory>
          <executable>sh</executable>
          <environmentVariables>
            <ZKRS_CLIENT>${rust-client}</ZKRS_CLIENT>
            <ZKRS_TLS>${rust-tls}</ZKRS_TLS>
            <ZKRS_TLS_PROVIDER>${rust-tls-provider}</ZKRS_TLS_PROVIDER>
            <ZKRS_CARGO_VENDOR>${rust-cargo-vendor}</ZKRS_CARGO_VENDOR>
            <ZKRS_SYSTEM_CRATES>${rust-system-crates}</ZKRS_SYSTEM_CRATES>
            <ZKRS_OPENSSL>${c-client-openssl}</ZKRS_OPENSSL>
            <ZKRS_SASL>${c-client-sasl}</ZKRS_SASL>
            <ZKRS_VERSION>${project.version}</ZKRS_VERSION>
            <ZKRS_BUILD_DIR>${project.build.directory}</ZKRS_BUILD_DIR>
            <ZKRS_SKIP_TESTS>${skipTests}</ZKRS_SKIP_TESTS>
            <ZKRS_TEST_MODE>${rust-test-mode}</ZKRS_TEST_MODE>
            <ZKRS_TEST_PORT_BASE>${rust-test-port-base}</ZKRS_TEST_PORT_BASE>
            <CARGO_TARGET_DIR>${project.build.directory}/cargo</CARGO_TARGET_DIR>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <!-- checks the options, the toolchain and the version; makes the TLS and SASL decisions and fetches the crates -->
            <id>rust-prepare</id>
            <phase>process-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>${project.basedir}/maven/rust-module.sh</argument>
                <argument>prepare</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- builds the zk-ffi staticlib with the capi profile, then the other crates -->
            <id>rust-build</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>${project.basedir}/maven/rust-module.sh</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <!-- this module isn't to be deployed to Maven Central -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <!--
          The root pom excludes these files for a scan from the root. A scan
          of this module uses paths relative to the module, so the module
          gives the same excludes in that form.
          -->
          <excludes combine.children="append">
            <exclude>**/Cargo.lock</exclude>
            <exclude>supply-chain/*.toml</exclude>
            <exclude>supply-chain/imports.lock</exclude>
            <exclude>**/target/**</exclude>
            <exclude>fuzz/corpus/**</exclude>
            <exclude>fuzz/artifacts/**</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>rust-client-yes</id>
      <activation>
        <property>
          <name>rust-client</name>
          <value>yes</value>
        </property>
      </activation>
      <properties>
        <rust-skip>false</rust-skip>
      </properties>
    </profile>
    <profile>
      <!-- -DskipCargoTest or -DskipTests skips the cargo tests -->
      <id>cargo-test</id>
      <activation>
        <property>
          <name>!skipCargoTest</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>rust-test</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <!-- the environment of the cppunit profile of zookeeper-client-c -->
                  <environmentVariables>
                    <LD_LIBRARY_PATH>${env.LD_LIBRARY_PATH};/usr/lib</LD_LIBRARY_PATH>
                    <CALLER>ANT</CALLER>
                    <CLOVER_HOME>${project.basedir}/../../zookeeper-server/target</CLOVER_HOME>
                    <base_dir>${project.basedir}/../..</base_dir>
                  </environmentVariables>
                  <arguments>
                    <argument>${project.basedir}/maven/rust-module.sh</argument>
                    <argument>test</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- -DskipRustLint skips the lint checks -->
      <id>rust-lint</id>
      <activation>
        <property>
          <name>!skipRustLint</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <!-- cargo fmt check and cargo clippy with -D warnings -->
                <id>rust-lint</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>${project.basedir}/maven/rust-module.sh</argument>
                    <argument>lint</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- opt-in with -Prust-supply-chain: cargo deny, cargo vet, cargo audit and the closure comparison -->
      <id>rust-supply-chain</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>rust-supply-chain</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>${project.basedir}/maven/rust-module.sh</argument>
                    <argument>supply-chain</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- opt-in with -Prust-integration: the Curator interop test of zk-recipes against real servers -->
      <id>rust-integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>rust-curator-interop</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <environmentVariables>
                    <ZKRS_IT_PORT_BASE>${rust-it-port-base}</ZKRS_IT_PORT_BASE>
                    <ZKRS_IT_VERSIONS>${rust-it-server-versions}</ZKRS_IT_VERSIONS>
                    <ZKRS_IT_MVN_ARGS>${rust-it-mvn-args}</ZKRS_IT_MVN_ARGS>
                    <!-- the text around the expression makes a string of the boolean setting -->
                    <ZKRS_MVN_OFFLINE>offline=${settings.offline}</ZKRS_MVN_OFFLINE>
                    <ZKRS_MVN_REPO>${settings.localRepository}</ZKRS_MVN_REPO>
                  </environmentVariables>
                  <arguments>
                    <argument>${project.basedir}/maven/rust-module.sh</argument>
                    <argument>interop</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- the cargo tests with coverage instrumentation (needs cargo-llvm-cov) -->
      <id>rust-test-coverage</id>
      <properties>
        <rust-test-mode>coverage</rust-test-mode>
      </properties>
    </profile>
    <profile>
      <!-- the cargo tests with AddressSanitizer and LeakSanitizer (needs a nightly toolchain) -->
      <id>rust-test-asan</id>
      <properties>
        <rust-test-mode>asan</rust-test-mode>
      </properties>
    </profile>
  </profiles>

</project>

# The pkg-config file of the st flavor of the Rust client core.
# Libs.private has the link libraries of the flavor and
# the native libraries of the Rust core. It never has OpenSSL.
prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: zookeeper_st
Description: Apache ZooKeeper C client library, single-threaded
Version: @PACKAGE_VERSION@
Cflags: -I${includedir} -I${includedir}/zookeeper
Libs: -L${libdir} -lzookeeper_st
Libs.private: @ZKRS_PC_PRIVATE_st@
